# Copy to .env (gitignored), fill in the required values, then run `uv run mda deploy`.
# `mda deploy` uploads every non-empty value as a deployment secret, except
# LANGSMITH_API_KEY. Slack needs nothing here: the first deploy prints a link to approve the app.

# --- Required ---

# LangSmith personal access token (lsv2_pt_...) for the workspace you deploy to
# (LangSmith -> Settings -> API Keys). Only used to deploy; never uploaded.
LANGSMITH_API_KEY=

# Tool Gateway kit's MCP URL (LangSmith -> Tools -> your kit), such as
# https://api.smith.langchain.com/v1/managed-tools/kits/<kit-id>/mcp
# Without it the agent deploys but has no integrations (Google, Slack, Linear, GitHub...).
TOOLS_MCP_URL=

# Model, called directly with your key. For OpenAI, use AGENT_MODEL=openai:gpt-6.2-sol and
# OPENAI_API_KEY instead.
AGENT_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=

# --- Optional ---

# Needed if your API key covers more than one workspace, such as an organization-wide
# service key (LangSmith -> Settings -> General -> Workspace ID).
# LANGSMITH_WORKSPACE_ID=

# Integrations run as the person talking. Set a profile to use its accounts for everyone instead.
# TOOLS_PROFILE=

# LangSmith LLM Gateway instead of your own provider key: remove AGENT_MODEL and
# ANTHROPIC_API_KEY above, and add an Anthropic provider secret in your workspace's LLM
# Gateway settings.
