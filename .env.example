# Copy to .env, fill in your values, and keep .env private.
# Full walkthrough: README.md#langsmith-api-key-and-workspace

# LangSmith deployment and local Studio access.
# Use a personal access token for the interactive quickstart.
# Select the same workspace for the key, tool kit, and deployment.
LANGSMITH_API_KEY=<your-langsmith-personal-access-token>
LANGSMITH_WORKSPACE_ID=<your-workspace-id>

# Tool Gateway: works with every model option below.
# Copy MCP URL from LangSmith > Tools > Tool kits > your workspace kit.
TOOLS_MCP_URL=<your-tool-kit-mcp-url>

# OPTION 1 — DEFAULT: Claude Opus, directly through Anthropic.
# Set your Anthropic API key; no LLM Gateway setup is required.
AGENT_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# OPTION 2 — GPT, directly through OpenAI.
# Comment out the two active Anthropic lines above, then uncomment these.
# Keep exactly one active AGENT_MODEL line.
# AGENT_MODEL=openai:gpt-6.1-sol
# OPENAI_API_KEY=<your-openai-api-key>

# OPTION 3 — LLM Gateway (Opus example).
# Comment out the direct-provider lines above, then uncomment AGENT_MODEL below.
# Store ANTHROPIC_API_KEY in the deployment workspace's LangSmith Secrets.
# For local gateway access, the LangSmith key needs that workspace as its scope
# (a PAT uses its Default Workspace), plus gateway:invoke and workspaces:read.
# Organization-scoped gateway keys are not supported.
# AGENT_MODEL=langsmith:anthropic/claude-opus-5-5

# Leave unset to run tools with each person's own connected accounts.
# Set only when you deliberately want a shared profile's credentials.
# TOOLS_PROFILE=<your-shared-profile>

# For a region other than GCP US, set its API endpoint before deploying.
# See README.md#setup-troubleshooting for the region table.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
